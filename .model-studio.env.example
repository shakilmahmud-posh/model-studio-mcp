# Copy to ~/.model-studio.env and chmod 600 it.
# MODEL_STUDIO_ENV overrides the location entirely.
#
# Get a key: Alibaba Cloud Model Studio console -> API keys.
# `bash install-key.sh <downloaded-file>` will move it here for you without the
# key ever reaching stdout, a log, or an agent session.

DASHSCOPE_API_KEY=sk-your-key-here

# Optional. A workspace id scopes calls to a workspace host; without one the
# global international host is used as a fallback.
# DASHSCOPE_WORKSPACE=llm-xxxxxxxxxxxxxxxx
# DASHSCOPE_REGION=ap-southeast-1
